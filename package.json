{
  "name": "skladno",
  "private": true,
  "version": "1.0.0",
  "description": "Иллюстрация из одной фразы: композиции из готовых векторных объектов библиотеки",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \"src/client/**\" --ignore \"**/*.timestamp-*\" src/server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --ssr src/server/index.ts --outDir dist-server",
    "start": "node dist-server/index.js",
    "extract": "tsx scripts/extract-library.ts",
    "examples": "tsx scripts/make-examples.ts",
    "checks": "tsx scripts/render-checks.ts",
    "compare-llm": "tsx scripts/compare-providers.ts",
    "test": "node scripts/run-tests.mjs",
    "test:resume": "node scripts/run-tests.mjs --resume",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
