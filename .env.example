# Ключи провайдеров (необязательны: без них работает словарный режим)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Порядок провайдеров: первый — основной, второй — запасной
LLM_PRIMARY=anthropic
LLM_FALLBACK=deepseek

# Модели
ANTHROPIC_MODEL=claude-haiku-5-5
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Лимиты
AI_LIMIT_PER_BROWSER=3
AI_LIMIT_PER_IP=10
# Потолок AI-вызовов на весь сервис (все посетители вместе) за 24 часа; дальше — словарь
AI_LIMIT_GLOBAL=300
RATE_LIMIT_PER_MINUTE=30
# Лимиты AI действуют в скользящем окне 24 часа
# Потолок одного вызова провайдера и общий дедлайн всей цепочки (основной + запасной), мс
LLM_TIMEOUT_MS=12000
LLM_DEADLINE_MS=12000

# За nginx или другим прокси: брать адрес клиента из X-Forwarded-For
# TRUST_PROXY=1

PORT=5173
